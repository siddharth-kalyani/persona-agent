{
  "name": "vanimo-in-dev-l1-backstop",
  "description": "Vanimo: blocks model input/output holding PII that redaction should have removed",
  "blockedInputMessaging": "Blocked by Vanimo's sensitive-data check.",
  "blockedOutputsMessaging": "Blocked by Vanimo's sensitive-data check.",
  "sensitiveInformationPolicyConfig": {
    "piiEntitiesConfig": [
      {
        "type": "ADDRESS",
        "action": "BLOCK"
      },
      {
        "type": "AWS_ACCESS_KEY",
        "action": "BLOCK"
      },
      {
        "type": "AWS_SECRET_KEY",
        "action": "BLOCK"
      },
      {
        "type": "CA_HEALTH_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "CA_SOCIAL_INSURANCE_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "CREDIT_DEBIT_CARD_CVV",
        "action": "BLOCK"
      },
      {
        "type": "CREDIT_DEBIT_CARD_EXPIRY",
        "action": "BLOCK"
      },
      {
        "type": "CREDIT_DEBIT_CARD_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "DRIVER_ID",
        "action": "BLOCK"
      },
      {
        "type": "EMAIL",
        "action": "BLOCK"
      },
      {
        "type": "INTERNATIONAL_BANK_ACCOUNT_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "IP_ADDRESS",
        "action": "BLOCK"
      },
      {
        "type": "LICENSE_PLATE",
        "action": "BLOCK"
      },
      {
        "type": "MAC_ADDRESS",
        "action": "BLOCK"
      },
      {
        "type": "NAME",
        "action": "BLOCK"
      },
      {
        "type": "PASSWORD",
        "action": "BLOCK"
      },
      {
        "type": "PHONE",
        "action": "BLOCK"
      },
      {
        "type": "SWIFT_CODE",
        "action": "BLOCK"
      },
      {
        "type": "UK_NATIONAL_HEALTH_SERVICE_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "UK_NATIONAL_INSURANCE_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "UK_UNIQUE_TAXPAYER_REFERENCE_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "US_BANK_ACCOUNT_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "US_BANK_ROUTING_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "US_INDIVIDUAL_TAX_IDENTIFICATION_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "US_PASSPORT_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "US_SOCIAL_SECURITY_NUMBER",
        "action": "BLOCK"
      },
      {
        "type": "VEHICLE_IDENTIFICATION_NUMBER",
        "action": "BLOCK"
      }
    ],
    "regexesConfig": [
      {
        "name": "india_aadhaar",
        "description": "Aadhaar number (12 digits)",
        "pattern": "\\b[2-9][0-9]{3}[ -]?[0-9]{4}[ -]?[0-9]{4}\\b",
        "action": "BLOCK"
      },
      {
        "name": "india_pan",
        "description": "PAN (income-tax ID)",
        "pattern": "\\b[A-Za-z]{3}[ABCFGHJLPTabcfghjlpt][A-Za-z][0-9]{4}[A-Za-z]\\b",
        "action": "BLOCK"
      },
      {
        "name": "india_gstin",
        "description": "GSTIN",
        "pattern": "\\b[0-3][0-9][A-Za-z]{5}[0-9]{4}[A-Za-z][1-9A-Za-z][Zz][0-9A-Za-z]\\b",
        "action": "BLOCK"
      },
      {
        "name": "india_ifsc",
        "description": "IFSC bank branch code",
        "pattern": "\\b[A-Za-z]{4}0[A-Za-z0-9]{6}\\b",
        "action": "BLOCK"
      },
      {
        "name": "india_upi",
        "description": "UPI payment address",
        "pattern": "\\b[A-Za-z0-9._-]{2,64}@(?:okaxis|okhdfcbank|okicici|oksbi|ybl|ibl|axl|apl|paytm|upi|ptyes|ptsbi|ptaxis|pthdfc)\\b",
        "action": "BLOCK"
      }
    ]
  }
}
