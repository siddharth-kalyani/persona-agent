# Copy to .env next to compose.yml on the instance, then: sudo chown root:root .env && sudo chmod 600 .env
# Never commit the real file. Generate each secret with:  openssl rand -hex 32

# Database passwords (the Postgres superuser, the schema owner, the API's role).
PG_ADMIN_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Keys for opaque references and the per-user vault. Losing the vault key makes stored data unreadable
# (here: synthetic only; the sample workspace can be learned again).
VANIMO_REF_HMAC_KEY=
VANIMO_VAULT_MASTER_KEY=

# From the AWS setup steps (app/deploy/ec2/README.md).
VANIMO_GUARDRAIL_ID=
VANIMO_GUARDRAIL_VERSION=1
VANIMO_L1_SNAPSHOT_BUCKET=

# With CloudFront in front (its VPC origin connects to port 8080 on the instance's private address).
# Leave both commented out while the app is reached only through the SSM tunnel.
# VANIMO_WEB_BIND=0.0.0.0
# VANIMO_WEB_URL=https://dxxxxxxxxxxxxx.cloudfront.net
