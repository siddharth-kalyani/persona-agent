{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ClaudeOnBedrock",
      "Effect": "Allow",
      "Action": "bedrock-mantle:CreateInference",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "ComprehendPii",
      "Effect": "Allow",
      "Action": "comprehend:DetectPiiEntities",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "Guardrail",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": "arn:aws:bedrock:ap-south-1:<ACCOUNT_ID>:guardrail/<GUARDRAIL_ID>"
    },
    {
      "Sid": "SnapshotWrites",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/l1/*"
    },
    {
      "Sid": "MacieFindings",
      "Effect": "Allow",
      "Action": [
        "macie2:ListFindings",
        "macie2:GetFindings"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    }
  ]
}
