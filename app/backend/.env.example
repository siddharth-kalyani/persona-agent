# Local development settings. Copy to .env (git-ignored) and fill in the Entra values.
VANIMO_ENV=local
VANIMO_CELL=in
VANIMO_DATABASE_URL=postgresql+psycopg://vanimo_app:vanimo_app_local@127.0.0.1:5433/vanimo
VANIMO_ENTRA_TENANT_ID=
VANIMO_ENTRA_CLIENT_ID=
VANIMO_ENTRA_CLIENT_SECRET=
# Bedrock calls use your local AWS credentials (aws configure / SSO) and need AWS_REGION=ap-south-1.
# Drafting (M3): "offline" = the labelled stand-in, no model (default until the AWS account exists);
# "bedrock" = Claude Haiku 5.5 / Sonnet 5.5 on Bedrock (needs the AWS credentials above).
VANIMO_DRAFTER=offline
