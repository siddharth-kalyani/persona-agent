" width="148" height="65" as="geometry"/></mxCell><mxCell id="m1" value="Entra records consent&lt;br&gt;Outlook add-in + Teams&lt;br&gt;app deployed" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fillColor=#F2F2F2;strokeColor=#737373;strokeWidth=1.5;" vertex="1" parent="L3"><mxGeometry x="54" y="38" width="148" height="65" as="geometry"/></mxCell><mxCell id="a2" value="Region: India first&lt;br&gt;(US later) · enrol users · set rules:&lt;br&gt;client scoping, redaction,&lt;br&gt;retention" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fillColor=#FFFFFF;strokeColor=#1F3A5F;strokeWidth=1.5;" vertex="1" parent="L5"><mxGeometry x="222" y="25" width="148" height="80" as="geometry"/></mxCell><mxCell id="p1" value="Tenant pinned to its&lt;br&gt;region cell · rules&lt;br&gt;stored" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fillColor=#EBF4FF;strokeColor=#2B6CB0;strokeWidth=1.5;" vertex="1" parent="L4"><mxGeometry x="222" y="55" width="148" height="65" as="geometry"/></mxCell><mxCell id="s1" value="Create the tenant&lt;br&gt;no access to content" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fillColor=#FFFFFF;strokeColor=#1F3A5F;strokeWidth=1.5;" vertex="1" parent="L7"><mxGeometry x="222" y="37" width="148" height="50" as="geometry"/></mxCell><mxCell id="u1" value="Sign in with Microsoft" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fillColor=#FFFFFF;strokeColor=#1F3A5F;strokeWidth=1.5;" vertex="1" parent="L1"><mxGeometry x="390" y="100" width="148" height="46" as="geometry"/></mxCell><mxCell id="p2" value="Header pass&lt;br&gt;metadata only, no&lt;br&gt;message text" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fillColor=#E6F4EA;strokeColor=#2F855A;strokeWidth=1.5;" verte