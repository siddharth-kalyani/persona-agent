# Vanimo web server on the EC2 instance (F11). Plain HTTP on port 8080, reached two ways: through an SSM
# port-forwarding tunnel (http://localhost:8080 on the laptop), and from CloudFront over its VPC origin
# (https://<distribution>.cloudfront.net; the security group admits only CloudFront, which terminates
# HTTPS). Security headers match the CloudFront ones in app/infra/vanimo_infra/app_stack.py.
{
	admin off
	auto_https off
	servers {
		# Only CloudFront and the tunnel can connect, so every peer may name the client. CloudFront sets
		# CloudFront-Viewer-Address (ip:port; the distribution is IPv4 only, as an IPv6 address arrives
		# without brackets and its port can't be split off). Through the tunnel there is no such header
		# and the client is the connection's own address.
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers CloudFront-Viewer-Address
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# Exactly one address per visitor, never one a browser sent: the API's login throttle counts
			# per client (uvicorn trusts this header from Caddy, FORWARDED_ALLOW_IPS in compose.yml).
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		header X-Frame-Options DENY
		header /config.json Cache-Control no-store
		# Client-side routes (no file extension) serve the app; files are served as they are, or 404.
		@route not path_regexp \.[A-Za-z0-9]+$
		rewrite @route /index.html
		file_server
	}
}
