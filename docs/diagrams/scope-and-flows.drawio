<mxfile host="app.diagrams.net"><diagram id="scope-and-flows" name="Scope and flows"><mxGraphModel dx="3420" dy="1353" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3420" pageHeight="1353" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="PersonaAgent — end-to-end flow and scope, by user" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fontSize=22;fontStyle=1;fontColor=#1F3A5F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1400" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Each row is one kind of user or system. Left: the MVP, step by step. Right: what each row gains in later phases. Sources: docs/03 (scope, phases) and docs/02 (architecture). Updated 2026-10-12." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fontSize=13;fontColor=#4A5568;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="2000" height="22" as="geometry"/></mxCell><mxCell id="panel_mvp" value="&lt;b&gt;MVP · solo build M0–M6 (~17–22 weeks)&lt;/b&gt; — how it works, step by step" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fontSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="64" y="96" width="2352" height="30" as="geometry"/></mxCell><mxCell id="panel_later" value="&lt;b&gt;After the MVP&lt;/b&gt; — what each user gains" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;fontSize=14;fillColor=#4A5568;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2456" y="96" width="944" height="30" as="geometry"/></mxCell><mxCell id="stage0" value="&lt;b&gt;1 · Set up&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12