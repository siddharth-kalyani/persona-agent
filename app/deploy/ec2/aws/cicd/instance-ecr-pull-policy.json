{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrSignIn",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullReleaseImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:<ACCOUNT_ID>:repository/vanimo-api",
        "arn:aws:ecr:ap-south-1:<ACCOUNT_ID>:repository/vanimo-web"
      ]
    }
  ]
}
